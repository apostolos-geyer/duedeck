
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        String?
  program       String?
  currentTerm   String?
  sessions      Session[]
  accounts      Account[]
  documents     Document[]
  enrollments   Enrollment[]
  studyGroupMemberships StudyGroupMember[]
  studyGroupsCreated    StudyGroup[]       @relation("StudyGroupCreator")
  studyGroupActivityAsSubject StudyGroupActivity[] @relation("StudyGroupActivitySubject")
  studyGroupActivityAsActor   StudyGroupActivity[] @relation("StudyGroupActivityActor")
  sentMessages  Message[]
  directMessagesSent     DirectMessage[] @relation("DirectSent")
  directMessagesReceived DirectMessage[] @relation("DirectReceived")
  calendarConnections CalendarConnection[]
  calendarEventLinks CalendarEventLink[]
  reminderPreferences ReminderPreference[]
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Document {
  id                  String         @id @default(uuid())
  sectionId           String?
  filename            String
  s3Key               String
  contentHash         String
  parsedS3Key         String?
  uploadedById        String
  status              String         @default("pending")
  error               String?
  extractedData       Json?
  uploadedAt          DateTime       @default(now())
  parsedDeadlineCount Int            @default(0)

  uploadedBy          User           @relation(fields: [uploadedById], references: [id])
  section             CourseSection? @relation(fields: [sectionId], references: [id])

  @@index([sectionId, contentHash])
  @@index([uploadedById])
  @@map("document")
}

model School {
  id        String   @id @default(uuid())
  name      String
  shortName String
  courses   Course[]

  @@unique([shortName])
  @@map("school")
}

model Course {
  id          String          @id @default(uuid())
  schoolId    String
  code        String
  name        String
  school      School          @relation(fields: [schoolId], references: [id])
  sections    CourseSection[]
  studyGroups StudyGroup[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("course")
}

model CourseSection {
  id         String        @id @default(uuid())
  courseId   String
  term       String
  section    String
  instructor String
  theme      String        @default("blue")
  course     Course        @relation(fields: [courseId], references: [id])
  deadlines  Deadline[]
  gradeWeights GradeWeight[]
  documents  Document[]
  enrollments Enrollment[]
  /// One shared chat for everyone enrolled in this section ("class chat").
  classChat  StudyGroup?   @relation("SectionClassChat")

  @@unique([courseId, term, section])
  @@index([courseId])
  @@map("course_section")
}

model Enrollment {
  id        String        @id @default(uuid())
  userId    String
  sectionId String
  enrolledAt DateTime     @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
  @@map("enrollment")
}

model Deadline {
  id        String        @id @default(uuid())
  sectionId String
  title     String
  dueDate   DateTime
  type      String
  weight    Float
  completed Boolean       @default(false)
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  calendarEventLinks CalendarEventLink[]

  @@index([sectionId])
  @@index([dueDate])
  @@map("deadline")
}

model GradeWeight {
  id        String        @id @default(uuid())
  sectionId String
  label     String
  type      String
  weight    Float
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("grade_weight")
}

model StudyGroup {
  id         String             @id @default(uuid())
  name       String
  courseId   String
  /// When set, this is the canonical class chat for that section (enrollment required).
  sectionId  String?            @unique
  maxMembers Int                @default(6)
  /// Custom groups only: listed in course browse when true; when false, join via invite only.
  isPublic   Boolean            @default(true)
  /// Custom groups: user who created the group (manages visibility, size, kicking). Null on legacy rows.
  createdById String?
  createdAt  DateTime           @default(now())
  course     Course             @relation(fields: [courseId], references: [id])
  section    CourseSection?     @relation("SectionClassChat", fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("StudyGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    StudyGroupMember[]
  messages   Message[]
  activities StudyGroupActivity[]

  @@index([courseId])
  @@index([sectionId])
  @@map("study_group")
}

/// Join / leave / kick events for group chat log (beside messages).
model StudyGroupActivity {
  id            String   @id @default(uuid())
  groupId       String
  /// member_joined | member_left | member_removed
  type          String
  subjectUserId String
  actorUserId   String?
  createdAt     DateTime @default(now())
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject       User       @relation("StudyGroupActivitySubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  actor         User?      @relation("StudyGroupActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@map("study_group_activity")
}

model StudyGroupMember {
  id       String     @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("study_group_member")
}

model Message {
  id        String     @id @default(uuid())
  groupId   String
  senderId  String
  content   String
  createdAt DateTime   @default(now())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id])

  @@index([groupId, createdAt])
  @@map("message")
}

/// 1:1 chat between two users who share at least one study group.
model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  sender      User     @relation("DirectSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("DirectReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@map("direct_message")
}

model CalendarConnection {
  id                   String    @id @default(uuid())
  userId               String
  provider             String
  connected            Boolean   @default(false)
  email                String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  providerAccountId    String?
  scope                String?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("calendar_connection")
}

model CalendarEventLink {
  id              String   @id @default(uuid())
  userId          String
  deadlineId      String
  provider        String
  externalEventId String
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadline        Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)

  @@unique([userId, deadlineId, provider])
  @@index([userId, provider])
  @@map("calendar_event_link")
}

model ReminderPreference {
  id            String  @id @default(uuid())
  userId        String
  channel       String
  enabled       Boolean @default(true)
  offsetMinutes Int
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("reminder_preference")
}

